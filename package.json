{
  "name": "dsh-updater-ui",
  "version": "1.2.3",
  "description": "DeepSeek Harness 官方更新检查器：按当前进程安装方式检查官方更新。源码走 git pull --ff-only；npx/npm 全局走 npm registry。自动后台检查 + 红点提醒 + 版本对比。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "updater", "plugin"],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["host.js", "client.js", "cordis.patch.yml"],
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "https://github.com/xingyingyuzhui/dsh-updater-ui.git"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
